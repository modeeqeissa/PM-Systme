# iam-service configuration. Copy to .env for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.

IAM_DATABASE_URL=postgresql+asyncpg://pmp:pmp_dev_only@localhost:5432/identity_db
IAM_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/identity_db

# RS256 signing key (PEM). If unset, a dev key is generated and cached to
# .dev-jwt-private.pem next to the service. MUST be set in staging/production.
IAM_JWT_PRIVATE_KEY=
IAM_JWT_ISSUER=pmp-iam-service
IAM_JWT_KID=iam-dev-1

# urlsafe-base64 32-byte Fernet key for MFA-secret encryption at rest.
IAM_MFA_ENC_KEY=

# Policy knobs
IAM_ACCESS_TOKEN_TTL=900
IAM_REFRESH_TOKEN_TTL=604800
IAM_MAX_FAILED_LOGINS=5
IAM_PASSWORD_MIN_LENGTH=12
