# notification-service configuration. Copy to .env for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://pmp:pmp_dev_only@localhost:5432/notification_db
NOTIFICATION_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/notification_db
