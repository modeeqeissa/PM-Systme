# integration-gateway-service configuration. Copy to .env for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.
INTEGRATION_GATEWAY_DATABASE_URL=postgresql+asyncpg://pmp:pmp_dev_only@localhost:5432/integration_db
INTEGRATION_GATEWAY_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/integration_db
