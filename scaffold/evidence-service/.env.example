# evidence-service configuration. Copy to .env for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.

# The RUNNING SERVICE connects as the least-privilege application role
# (created by migration 0001): SELECT/INSERT only on custody_events.
EVIDENCE_DATABASE_URL=postgresql+asyncpg://evidence_service_app:evidence_app_dev_only@localhost:5432/evidence_db
# ALEMBIC connects as the owner role (needs DDL).
EVIDENCE_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/evidence_db

# iam-service JWKS for RS256 access-token verification
EVIDENCE_IAM_JWKS_URL=http://localhost:8001/api/v1/auth/jwks
EVIDENCE_JWT_ISSUER=pmp-iam-service
EVIDENCE_JWKS_CACHE_TTL=300

# Encrypted evidence vault (dev: local Fernet-encrypted directory)
EVIDENCE_VAULT_DIR=./.evidence-vault-dev
# urlsafe-base64 32-byte Fernet key; MUST be set in staging/production
EVIDENCE_VAULT_KEY=
