# audit-service configuration. Copy to .env for non-local environments.
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_service_app:audit_app_dev_only@localhost:5432/audit_db
AUDIT_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/audit_db
AUDIT_IAM_JWKS_URL=http://localhost:8001/api/v1/auth/jwks
AUDIT_JWT_ISSUER=pmp-iam-service
EVENTS_KAFKA_BOOTSTRAP=localhost:29092
AUDIT_CONSUMER_GROUP=audit-service
AUDIT_RETENTION_DAYS=3650
