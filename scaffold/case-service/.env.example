# case-service configuration. Copy to .env and fill in for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.

# Async URL used by the running service (asyncpg driver)
CASE_DATABASE_URL=postgresql+asyncpg://pmp:pmp_dev_only@localhost:5432/case_db
# Sync URL used by Alembic migrations (psycopg2 driver)
CASE_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/case_db
