# training-service configuration. Copy to .env for non-local environments.
# Local dev falls back to the infra/docker-compose.yml Postgres automatically.
TRAINING_DATABASE_URL=postgresql+asyncpg://pmp:pmp_dev_only@localhost:5432/training_db
TRAINING_DATABASE_URL_SYNC=postgresql+psycopg2://pmp:pmp_dev_only@localhost:5432/training_db
